{
  "expo": {
    "name": "MakonBook",
    "slug": "makonbook-mobile",
    "version": "1.0.0",
    "icon": "./assets/app-icon.png",
    "orientation": "portrait",
    "scheme": "makonbookmobile",
    "userInterfaceStyle": "automatic",
    "backgroundColor": "#f5efe3",
    "ios": {},
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/app-icon.png",
        "backgroundColor": "#01000f"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.nazacd.makonbookmobile",
      "blockedPermissions": [
        "android.permission.SYSTEM_ALERT_WINDOW",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.VIBRATE",
        "android.permission.RECORD_AUDIO",
        "android.permission.WRITE_SETTINGS"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/app-icon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#f5efe3",
          "image": "./assets/makonbook-icon.png",
          "imageWidth": 140,
          "dark": {
            "backgroundColor": "#0b1a2a",
            "image": "./assets/makonbook-icon.png"
          }
        }
      ],
      "expo-asset",
      "expo-secure-store",
      [
        "expo-camera",
        {
          "cameraPermission": "MakonBook uses the camera to scan your teacher’s attendance code.",
          "recordAudioAndroid": false
        }
      ],
      "expo-font"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "0199b10f-895f-439b-991f-528d493fc624"
      }
    }
  }
}
