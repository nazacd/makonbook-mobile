# Copy to `.env` and fill in. `.env` is git-ignored.
# Desmos graphing calculator API key — request one at https://www.desmos.com/api
EXPO_PUBLIC_DESMOS_API_KEY=
# MakonBook API. Optional: defaults to https://api.makonbook.uz. Point it at a
# local makonbook-api (e.g. http://192.168.1.10:8080) to develop against one.
EXPO_PUBLIC_API_URL=
